---
import type { Post } from '../lib/posts';
import { postPath } from '../lib/posts';
import { formatDate, ui, type Language } from '../i18n';
import { readingMinutes } from '../lib/content-utils';
interface Props { post: Post; lang: Language; featured?: boolean; index?: number }
const { post, lang, featured = false, index } = Astro.props;
const minutes = readingMinutes(post.body ?? '', lang);
---
<article class:list={{ card: true, featured }}>
  <div class="aside">
    {index !== undefined && <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} {ui[lang].minuteRead}</span>
    </div>
  </div>
  <h3><a href={postPath(post)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  {post.data.tags.length > 0 && <ul aria-label={lang === 'zh' ? '标签' : 'Tags'}>
    {post.data.tags.map((tag) => <li>{tag}</li>)}
  </ul>}
</article>
<style>
  .card { position: relative; display: grid; grid-template-columns: 8.5rem 1fr; column-gap: 1.5rem; padding: 1.75rem .85rem; margin-inline: -.85rem; border-bottom: 1px solid var(--line); cursor: pointer; transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .card:hover, .card:focus-within { border-color: var(--glass-line); outline: 1px solid var(--glass-line); outline-offset: -1px; background: var(--glass-bg); box-shadow: var(--glass-shadow); backdrop-filter: blur(22px) saturate(130%); -webkit-backdrop-filter: blur(22px) saturate(130%); }
  .card::after { content: '↗'; position: absolute; z-index: 2; top: 1.7rem; right: 0; color: var(--muted); font-size: .85rem; pointer-events: none; transition: transform 160ms ease, color 160ms ease; }
  .card:hover::after, .card:focus-within::after { color: var(--accent); transform: translate(2px, -2px); }
  .aside { grid-column: 1; grid-row: 1 / span 3; }
  .number { display: block; margin-bottom: .65rem; color: var(--accent); font-family: ui-monospace, monospace; font-size: .68rem; font-weight: 650; }
  .meta { display: flex; flex-direction: column; gap: .15rem; color: var(--muted); font-family: ui-monospace, monospace; font-size: .68rem; }
  .meta span[aria-hidden] { display: none; }
  h3 { grid-column: 2; max-width: 46rem; margin: 0 0 .55rem; font-size: clamp(1.15rem, 2.2vw, 1.4rem); font-weight: 600; letter-spacing: -.025em; line-height: 1.3; }
  h3 a { padding-right: 2rem; text-decoration: none; }
  h3 a::after { content: ''; position: absolute; z-index: 1; inset: 0; }
  h3 a:focus-visible { outline: none; }
  h3 a:focus-visible::after { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card:hover h3 a, .card:focus-within h3 a { color: var(--accent); }
  p { grid-column: 2; max-width: 42rem; margin: 0; color: var(--muted); font-size: .9rem; }
  ul { grid-column: 2; display: flex; flex-wrap: wrap; gap: .75rem; margin: .8rem 0 0; padding: 0; color: var(--muted); list-style: none; }
  li { font-family: ui-monospace, monospace; font-size: .66rem; }
  li::before { content: '#'; }
  @media (max-width: 580px) {
    .card { grid-template-columns: 1fr; }
    .aside { grid-column: 1; grid-row: auto; margin-bottom: .6rem; }
    .number { display: inline; margin-right: .65rem; }
    .meta { display: inline-flex; flex-direction: row; gap: .5rem; }
    .meta span[aria-hidden] { display: inline; }
    h3, p, ul { grid-column: 1; }
  }
</style>
