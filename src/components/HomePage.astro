---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import MiniTerminal from './MiniTerminal.astro';
import Pagination from './Pagination.astro';
import { ui, type Language } from '../i18n';
import { siteConfig } from '../config';
import { getPosts, postPath, postSlug } from '../lib/posts';
import { homePagePath, pageCount, pageItems, POSTS_PER_PAGE } from '../lib/pagination';

interface Props {
  lang: Language;
  page: number;
}

const { lang, page } = Astro.props;
const posts = await getPosts(lang);
const totalPages = pageCount(posts.length);
const visiblePosts = pageItems(posts, page);
const t = ui[lang];
const otherLang = lang === 'zh' ? 'en' : 'zh';
const otherLanguagePages = pageCount((await getPosts(otherLang)).length);
const alternatePath = homePagePath(otherLang, Math.min(page, otherLanguagePages));
const canonicalPath = homePagePath(lang, page);
const title = page > 1 ? (lang === 'zh' ? `文章 · 第 ${page} 页` : `Writing · Page ${page}`) : undefined;
---
<BaseLayout {lang} {title} {canonicalPath} {alternatePath}>
  <section class="home-intro">
    <div class="container intro-grid">
      <div class="statement">
        <p class="label">Index / {new Date().getFullYear()}</p>
        <h1>Hi! This is Aether<span aria-hidden="true">👋</span></h1>
        <p class="intro">{siteConfig.intro[lang]}</p>
      </div>
      <div class="side">
        <MiniTerminal {lang} posts={posts.map((post) => ({ slug: postSlug(post), title: post.data.title, url: postPath(post) }))} />
        <div class="stats" aria-label={lang === 'zh' ? '站点信息' : 'Site information'}>
          <span>ZH / EN</span>
          <span>{String(posts.length).padStart(2, '0')} {lang === 'zh' ? '篇文章' : 'POSTS'}</span>
        </div>
      </div>
    </div>
  </section>
  <section class="latest container">
    <div class="section-heading">
      <h2>{page === 1 ? t.latest : (lang === 'zh' ? `更多文章 · ${page}/${totalPages}` : `More writing · ${page}/${totalPages}`)}</h2>
      <a href={`/${lang}/archive/`}>{t.allPosts} →</a>
    </div>
    {visiblePosts.length
      ? <div class="post-list">{visiblePosts.map((post, index) => <PostCard {post} {lang} index={(page - 1) * POSTS_PER_PAGE + index} />)}</div>
      : <p class="muted">{t.noPosts}</p>}
    <Pagination {lang} {page} {totalPages} />
  </section>
</BaseLayout>
<style>
  .home-intro { padding-block: clamp(3.5rem, 8vw, 6rem); border-bottom: 1px solid var(--line); }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 32rem) minmax(18rem, 1fr); gap: clamp(2rem, 3vw, 2.75rem); align-items: start; }
  .statement { max-width: 32rem; }
  .label { margin: 0; color: var(--muted); font-family: ui-monospace, monospace; font-size: .68rem; text-transform: uppercase; }
  h1 { margin: 1rem 0 .85rem; font-size: clamp(2.1rem, 5vw, 3.5rem); font-weight: 600; letter-spacing: -.06em; line-height: 1; }
  h1 span { display: inline-block; margin-left: .2em; font-size: .72em; transform: rotate(-8deg); }
  .intro { max-width: 32rem; margin: 0; color: var(--muted); font-size: .95rem; }
  .side { justify-self: end; width: min(100%, 20rem); min-width: 0; }
  .stats { display: flex; justify-content: space-between; gap: 1rem; margin-top: .65rem; color: var(--muted); font-family: ui-monospace, monospace; font-size: .6rem; letter-spacing: .04em; }
  .latest { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .post-list { border-top: 1px solid var(--line); }
  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: minmax(0, 1fr) minmax(17rem, 19rem); }
  }
  @media (max-width: 700px) {
    .intro-grid { grid-template-columns: 1fr; }
    .side { width: min(100%, 23rem); }
  }
  @media (max-width: 460px) {
    h1 { font-size: 2rem; }
  }
</style>
