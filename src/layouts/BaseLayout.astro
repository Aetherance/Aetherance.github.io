---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MiniTerminal from '../components/MiniTerminal.astro';
import { siteConfig } from '../config';
import type { Language } from '../i18n';
import { getPosts, postPath, postSlug } from '../lib/posts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang: Language;
  canonicalPath?: string;
  alternatePath?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description, lang, canonicalPath = Astro.url.pathname, alternatePath, type = 'website', publishedTime } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
const pageDescription = description ?? siteConfig.description[lang];
const canonical = new URL(canonicalPath, Astro.site ?? siteConfig.siteUrl);
const otherLang = lang === 'zh' ? 'en' : 'zh';
const alternateUrl = alternatePath ? new URL(alternatePath, Astro.site ?? siteConfig.siteUrl) : undefined;
const isHome = Astro.url.pathname === `/${lang}/` || Astro.url.pathname.startsWith(`/${lang}/page/`);
const terminalPosts = isHome
  ? []
  : (await getPosts(lang)).map((post) => ({ slug: postSlug(post), title: post.data.title, url: postPath(post) }));
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f7f9fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1018" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={`/${lang}/rss.xml`} />
    {alternateUrl && <link rel="alternate" hreflang={otherLang} href={alternateUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => { const saved = localStorage.getItem('theme'); if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved; })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <Header {lang} {alternatePath} />
    <main id="main"><slot /></main>
    {!isHome && <MiniTerminal {lang} posts={terminalPosts} floating />}
    <Footer {lang} />
  </body>
</html>
